{
    "compilerOptions": {
        /* 语言与模块 */
        "target": "ES2022", // 输出的 JS 版本，Node 16+ 均支持
        "module": "CommonJS", // package.json 未设置 "type": "module"，Node 按 CommonJS 加载
        "lib": ["ES2022", "DOM"], // 内置 API；DOM 提供 console / setTimeout 的类型（未安装 @types/node）
        "esModuleInterop": true,

        /* 装饰器（SerializeDTO/02-DecoratorDTO.ts 需要） */
        "experimentalDecorators": true, // 旧版装饰器，与 NestJS / class-transformer 一致

        /* 类型检查 */
        "strict": true, // 开启全部严格检查（strictNullChecks、noImplicitAny 等）
        "skipLibCheck": true, // 跳过 .d.ts 检查，加快编译

        /* 输出 */
        "rootDir": ".",
        "outDir": "dist", // 编译产物放到 dist/，保持源码目录干净
        "sourceMap": true // 方便调试时定位到 .ts 源码
    },
    "include": ["**/*.ts"],
    // WsProtoServer 是独立子项目；DailyTask/net 依赖 ws，由 WsProtoServer 的 tsconfig 检查
    "exclude": ["node_modules", "dist", "WsProtoServer", "DailyTask/net"]
}
